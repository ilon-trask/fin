{
  "name": "fin",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w @fin/mobile",
    "web": "npm run web -w @fin/mobile",
    "android": "npm run android -w @fin/mobile",
    "build:android": "npm run build:android -w @fin/mobile",
    "ios": "npm run ios -w @fin/mobile",
    "sync:server": "npm run dev -w @fin/server",
    "lint": "npm run lint -w @fin/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "npm run db:generate -w @fin/mobile",
    "build:web": "npm run build:web -w @fin/mobile",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
