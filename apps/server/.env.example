# Generate with: openssl rand -hex 32
SYNC_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
PORT=3001
HOST=127.0.0.1
SYNC_DATABASE=./server-data/fin.db
# Required only when the browser UI is served from a separate origin.
SYNC_ALLOWED_ORIGIN=http://localhost:8081
# Optional: serve the exported mobile web app from Hono on the same origin.
# WEB_DIST=../mobile/dist
